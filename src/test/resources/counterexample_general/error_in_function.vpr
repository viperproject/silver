// Regression test: a counterexample must be produced (not crash) when the
// verification error is in a function rather than a method. Here f's
// postcondition is violated for x == 1 (result == 0).

function f(x: Int): Int
  requires x > 0
  //:: ExpectedCounterexample(postcondition.violated:assertion.false, (x == 1))
  ensures result > 0
{
  x - 1
}
