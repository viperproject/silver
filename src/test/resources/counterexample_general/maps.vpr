// Counterexample for map values, testing map-specific behaviour: the reported
// map is queried at concrete keys (m[k]), not just compared for equality.

method map_lookup(m: Map[Int, Int])
  requires m == Map(3 := 42, 5 := 100)
{
  //:: ExpectedCounterexample(assert.failed:assertion.false, (m[3] == 42, m[5] == 100))
  assert m[3] == m[5]
}
