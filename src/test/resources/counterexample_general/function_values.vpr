// Counterexample reporting the value of a function application at concrete
// arguments (foo(3)), independent of any local variable. Only the resolved
// counterexample (this folder) supports function-application resolution.

function foo(z: Int): Int
{
  z + 7
}

method bar()
{
  //:: ExpectedCounterexample(assert.failed:assertion.false, (foo(3) == 10))
  assert foo(3) != 10
}
