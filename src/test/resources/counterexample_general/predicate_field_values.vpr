// Tests that the counterexample recovers the values of fields held *inside* a
// folded predicate. P(x) is folded from concrete field values, so at the failing
// assertion the fields x.f and x.g are hidden inside P(x); the annotation asserts
// their values, which the extractor reads back from the predicate's snapshot.

field f: Int
field g: Int

predicate P(x: Ref) {
  acc(x.f) && acc(x.g) && x.f == 3
}

method m(x: Ref)
{
  inhale acc(x.f) && acc(x.g)
  x.f := 3
  x.g := 8
  fold P(x)
  //:: ExpectedCounterexample(assert.failed:assertion.false, (x.f == 3, x.g == 8))
  assert false
}
