// Tests that a magic wand held at the failure point is reported in the
// counterexample. The annotation asserts the presence of the wand itself
// (left --* right), which the extended annotation grammar now supports.

field f: Int

method m(x: Ref)
  requires acc(x.f, 1/2) --* (acc(x.f, 1/1) && x.f == 7)
{
  //:: ExpectedCounterexample(assert.failed:assertion.false, (acc(x.f, 1/2) --* acc(x.f, 1/1) && x.f == 7))
  assert false
}
