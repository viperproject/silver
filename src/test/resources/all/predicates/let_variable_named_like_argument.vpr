// The let variable b of the predicate body must not capture the argument b of the folds and unfolds.

field val: Int

predicate P(x: Ref) {
  (let b == (null) in b != x) ==> acc(x.val)
}

method foldWithoutPermission(b: Ref)
  requires b != null
{
  //:: ExpectedOutput(fold.failed:insufficient.permission)
  fold P(b)
}

method unfoldGivesPermission(b: Ref)
  requires b != null && P(b)
{
  unfold P(b)
  b.val := 1
}
