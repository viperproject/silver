// A let is not a valid trigger if it contains something that is forbidden in
// triggers or is, with its lets inlined, not a possible trigger, e.g. a field
// access or a wand (which are valid triggers without a let). See
// let_triggers.vpr for lets that are valid triggers.

function q(n: Int): Int
function s(a: Int, b: Int): Bool

method letValueForbiddenInTrigger()
  //:: ExpectedOutput(typechecker.error)
  requires forall i: Int :: { let x == (i + 1) in s(x, x) } s(i + 1, i + 1)
{}

method letBodyNotATrigger()
  //:: ExpectedOutput(typechecker.error)
  requires forall i: Int :: { let x == (q(i)) in x + 1 } q(i) + 1 > 0
{}

method letBodyIsVariableNotATrigger()
  //:: ExpectedOutput(typechecker.error)
  requires forall i: Int :: { let x == (i) in x } s(i, i)
{}

method letUnusedValueForbiddenInTrigger()
  //:: ExpectedOutput(typechecker.error)
  requires forall i: Int :: { let x == (i + 1) in s(i, i) } s(i, i)
{}

field f: Int
field g: Int

method letBodyIsFieldAccess(xs: Set[Ref])
  //:: ExpectedOutput(typechecker.error)
  requires forall r: Ref :: { let y == (r) in y.f } r in xs ==> acc(r.f)
{}

method letBodyIsWand(xs: Set[Ref])
  //:: ExpectedOutput(typechecker.error)
  requires forall r: Ref :: { let y == (r) in (acc(y.f) --* acc(y.g)) } r in xs ==> (acc(r.f) --* acc(r.g))
{}
