function foo(z: Int): Int
{
  z + 7
}

method bar()
{
  var x: Int
  assume x == 5
  var y: Int := foo(x)
  //:: ExpectedCounterexample(assert.failed:assertion.false, (x == 5, y == 12, foo(3) == 10))
  assert foo(3) != 10
}
